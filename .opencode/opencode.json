{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama P40 (192.168.88.10)",
      "options": {
        "baseURL": "http://192.168.88.10:11434/v1",
        "timeout": 300000,
        "headerTimeout": 300000,
        "chunkTimeout": 120000
      },
      "models": {
        "qwen3.5:9b-p40": {
          "name": "Qwen 3.5 9B (P40, fast)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "qwen3.6:27b-p40": {
          "name": "Qwen 3.6 27B (P40, smart)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 24576,
            "output": 4096
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B (stock)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "ollama/qwen3.6:27b-p40",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "instructions": ["/home/jaimie/projects/.opencode/instructions/nest.md"],
  "mcp": {
    "nest-memory": {
      "type": "local",
      "command": [
        "/home/jaimie/projects/.venv/bin/python",
        "/home/jaimie/projects/tools/mcp_memory_server.py"
      ],
      "cwd": "/home/jaimie/projects",
      "enabled": true,
      "timeout": 30000
    },
    "nest-context-memory": {
      "type": "local",
      "command": [
        "/home/jaimie/projects/.venv/bin/python",
        "/home/jaimie/projects/tools/mcp_context_memory_server.py"
      ],
      "cwd": "/home/jaimie/projects",
      "enabled": true,
      "timeout": 30000
    },
    "nest-knowledge": {
      "type": "local",
      "command": [
        "/home/jaimie/projects/.venv/bin/python",
        "/home/jaimie/projects/tools/mcp_knowledge_server.py"
      ],
      "cwd": "/home/jaimie/projects",
      "enabled": true,
      "timeout": 30000
    }
  }
}
