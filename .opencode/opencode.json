{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "nest-crates": ".opencode/skills/nest-crates.md",
    "nest-app-development": ".opencode/skills/nest-app-development.md",
    "nest-mcp-workflow": ".opencode/skills/nest-mcp-workflow.md"
  },
  "tools": {
    "find-nest-crate": true,
    "check-nest-dependencies": true,
    "add-nest-dependency": true
  },
  "instructions": [
    ".opencode/instructions/nest-framework.md",
    ".opencode/instructions/dependency-rules.md",
    ".opencode/instructions/error-handling.md",
    ".opencode/instructions/logging.md",
    ".opencode/instructions/tauri-apps.md",
    ".opencode/instructions/memory-workflow.md",
    ".opencode/instructions/desktop-ui.md",
    ".opencode/instructions/post-response.md"
  ],
  "mcp": {
    "nest-memory": {
      "type": "local",
      "command": [
        "{env:NEST_PROJECT_ROOT}/.venv/bin/python",
        "{env:NEST_PROJECT_ROOT}/tools/mcp_memory_server.py"
      ],
      "cwd": "{env:NEST_PROJECT_ROOT}",
      "enabled": true,
      "timeout": 30000
    },
    "nest-context-memory": {
      "type": "local",
      "command": [
        "{env:NEST_PROJECT_ROOT}/.venv/bin/python",
        "{env:NEST_PROJECT_ROOT}/tools/mcp_context_memory_server.py"
      ],
      "cwd": "{env:NEST_PROJECT_ROOT}",
      "enabled": true,
      "timeout": 30000
    },
    "nest-knowledge": {
      "type": "local",
      "command": [
        "{env:NEST_PROJECT_ROOT}/.venv/bin/python",
        "{env:NEST_PROJECT_ROOT}/tools/mcp_knowledge_server.py"
      ],
      "cwd": "{env:NEST_PROJECT_ROOT}",
      "enabled": true,
      "timeout": 30000
    }
  }
}
