# Example knowledge base config. scripts/index-knowledge.sh generates tools/knowledge.toml.
#
#   ./scripts/index-knowledge.sh
#
# Override the manuals root:
#   NEST_KNOWLEDGE=/data/nest-knowledge ./scripts/index-knowledge.sh
#
# webOS TV docs (Loon client) — fetch first:
#   ./scripts/fetch-webos-knowledge.sh   # planned; see apps/loon/docs/webos-knowledge-v1.md

[[collections]]
name = "rust-book"
source = "/data/nest-knowledge/rust/rust-book/src"
extensions = ["md"]

[[collections]]
name = "rust-by-example"
source = "/data/nest-knowledge/rust/rust-by-example/src"
extensions = ["md"]

[[collections]]
name = "rust-reference"
source = "/data/nest-knowledge/rust/rust-reference/src"
extensions = ["md"]

[[collections]]
name = "tauri"
source = "/data/nest-knowledge/tauri/tauri-docs/src/content/docs"
extensions = ["md", "mdx"]

[[collections]]
name = "react"
source = "/data/nest-knowledge/react/react.dev/src/content"
extensions = ["md"]

[[collections]]
name = "tailwind"
source = "/data/nest-knowledge/tailwind/tailwindcss.com/src/docs"
extensions = ["md", "mdx"]

# Uncomment after running ./scripts/fetch-webos-knowledge.sh
# [[collections]]
# name = "webos-tv"
# source = "/data/nest-knowledge/webos-tv"
# extensions = ["md"]
